{
  "name": "davidhirtz/yii2-dev",
  "description": "The shared development toolchain: the check script, the tool configurations and the tools themselves",
  "license": "proprietary",
  "type": "library",
  "homepage": "https://www.github.com/davidhirtz/yii2-dev",
  "authors": [
    {
      "name": "David Hirtz",
      "homepage": "https://www.davidhirtz.com/"
    }
  ],
  "require": {
    "php": "^8.3",
    "components/jquery": "^3.7",
    "friendsofphp/php-cs-fixer": "^3.91",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.2",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/var-dumper": "^7.4",
    "yiisoft/yii2-debug": "^2.1"
  },
  "bin": [
    "bin/check"
  ],
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true
  }
}
